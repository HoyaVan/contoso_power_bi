COGS (Foreign) = 
SUMX (
    'fact Sales',
    VAR LocalCost =
        'fact Sales'[UnitCost] * 'fact Sales'[Quantity]

    VAR FromCur =
        LOOKUPVALUE(
            'exchange currency rate'[FromCurrency],
            'exchange currency rate'[CurrencyKey], 'fact Sales'[CurrencyKey],
            'exchange currency rate'[Date],        'fact Sales'[OrderDate]
        )

    -- Rate that converts Local -> USD 
    VAR RateToUSD =
        LOOKUPVALUE(
            'exchange currency rate'[ExchangeRate],
            'exchange currency rate'[CurrencyKey], 'fact Sales'[CurrencyKey],
            'exchange currency rate'[Date],        'fact Sales'[OrderDate],
            'exchange currency rate'[ToCurrency],  "USD"
        )

    RETURN
        IF (
            FromCur <> "USD",
            DIVIDE( LocalCost, COALESCE( RateToUSD, 1 ) ),  -- convert non-USD
            LocalCost                                       -- USD stays as-is
        )
)
